# syntax=docker/dockerfile:1

# ClinIQ Production Frontend Nginx Runtime
FROM nginx:1.25-alpine

# Ensure SSL directory exists and generate a fallback self-signed certificate
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout /etc/nginx/ssl/selfsigned.key \
      -out /etc/nginx/ssl/selfsigned.crt \
      -subj "/CN=172.16.17.181"

# Copy pre-compiled Angular 19 production distribution
COPY dist/cbt-clinical-app/browser /usr/share/nginx/html

# Copy reverse proxy and security configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
